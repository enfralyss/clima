{
  "expo": {
    "name": "Clima",
    "slug": "clima",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a1f3d",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.enfralyss.clima",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
